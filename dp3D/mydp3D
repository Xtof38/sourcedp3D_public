#!/bin/bash
! $Id: mydp3D,v 2.7 2025/10/24 07:37:53 martinch Exp $

###########################################################################
# This is a script to get info on a dp3D proc 
###########################################################################

# Christophe.martin@inpg.fr    April 2007
#    if [ "$1" = "" ];then
      theuser=`whoami`
      system=`hostname`
      echo "For user $theuser :"
      if [ "$system" = "master0.simap.cluster" ];then
        echo "Looking only for slurm jobs"
	list_jobs=`squeue | grep $theuser | awk '{print $1}'`
	numjobs=`echo $list_jobs | awk '{print NF}'`
#        echo "list of jobs: $list_jobs"
        new_list=""  

	for job in $list_jobs
	do
          range=${job#[0-9]*_[}
          range=${range%]}
          job0=${job%_*}
#          echo "range $range job0 $job0"
          if [ $range != "$job" ];then
            IFS='-' read -r start end <<< "$range"
            list_jobs=$(printf '%s\n' "${list_jobs[@]}" | grep -vxF "$job") 
            for item in $(eval echo ""$job0"_{$start..$end}"); do
              new_list=$(echo "$new_list $item")
            done
          fi 
        done
        list_jobs=$(echo "$list_jobs $new_list")


	for job in $list_jobs
	do
	  node=`scontrol show job $job | grep  BatchHost | grep -o node.*`
	  status=`scontrol show job  $job | grep "JobState=.* " `
	  dir=`scontrol show job $job | grep WorkDir | sed 's/   WorkDir=//g'`
# because the job may have been submitted with sbatch, it might not be the correct dir:
          if [ -f "$dir"/log ];then
            last_dir=$dir
            echo ""
            echo "job $job is running on node $node with status $status"
            echo "in directory:"
            echo "$last_dir"
	    echo ""
          else
            last_dir=$(find "${dir:-.}" -name "log" -type f -mmin -20 -printf "%T@ %h\n" | awk '{ print $2 }')
            for dir in $last_dir;do
              echo ""
              echo "job is running in directory:"
              echo "$dir"
      	      echo ""
            done
            exit
          fi
	done
        echo "more details with scontrol show job num_job"
        if  [ $numjobs = "0" ];then
          echo "no dp3D process found with squeue"
        fi
	
      else
        ps -ef | grep "$theuser" | grep "dp3D" | sed '/mydp3D/d' | sed '/00:00:00/d' | sed '/\/bin\/sh/d' | sed '/nedit /d' | sed '/odp3D/d' | sed '/defunct/d' | awk '{ print $2 }' > tmp2
        numlines=`grep -c .  < tmp2`
        numproc="0"
        until [ "$numlines" = "0" ]
        do
         let "numlines-=1"
# get the first line of tmp2         
         pidn=`sed -n ''1'p' tmp2`
         sed '1,1d' tmp2 > tmp1
         mv -f tmp1 tmp2

         ls -ald  /proc/$pidn/exe* > tmp1
         whatdp3D=$(ps -ef | grep "$theuser" | grep "$pidn" | grep "dp3D" | awk '{ print $8 }')
#         whatdp3D=`grep  dp3D tmp1 | awk '{ print $NF }' | sed '/rasmol/d'`
# print section of file from regular expression to end of file
#         whatdp3D=`echo "$whatdp3D"  | sed -n '/\/dp3D/,$p'`
         if [ "$whatdp3D" != "" ];then
           echo ""
           echo "$whatdp3D  with PID $pidn  is running in directory :"
           ls -al  /proc/$pidn/cwd* | awk '{ print $NF }' 
           echo ""
           numproc="1"
         fi
        done
        if  [ $numproc -ne 1 ];then
          echo "no dp3D process found"
        fi
      fi
rm -f tmp1 tmp2
